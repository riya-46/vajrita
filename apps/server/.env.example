NODE_ENV=development
PORT=4000
# Local backend URL for development. Use your Railway URL after deployment.
APP_URL=http://localhost:4000
# Optional browser origins for CORS. Native app requests do not depend on these.
CLIENT_URL=http://localhost:8081
MOBILE_APP_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081,https://your-backend.up.railway.app
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vajrita
JWT_ACCESS_SECRET=replace-with-a-64-character-secret
JWT_REFRESH_SECRET=replace-with-a-64-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890
WHATSAPP_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_TEMPLATE_NAME=safety_alert
PROVIDER_MODE=fallback
CONTACT_VERIFICATION_BASE_URL=http://localhost:4000
